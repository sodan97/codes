# URL publique du site (utilisée pour le SEO, le sitemap, Open Graph et Schema.org)
NEXT_PUBLIC_SITE_URL=https://www.woolys.example

# URL de la plateforme de formation (LMS WOOLYS Academy). Si vide, le lien est masqué.
NEXT_PUBLIC_LMS_URL=

# Adresse e-mail de contact affichée sur le site (PLACEHOLDER à remplacer)
NEXT_PUBLIC_CONTACT_EMAIL=

# Lien de prise de rendez-vous (Calendly, Cal.com, Microsoft Bookings...). Si vide, renvoie vers /contact.
NEXT_PUBLIC_BOOKING_URL=

# Profil LinkedIn de l'entreprise (optionnel)
NEXT_PUBLIC_LINKEDIN_URL=

# Webhook qui reçoit les demandes du formulaire de contact (Make, Zapier, n8n, CRM, Slack...).
# Requis en production : sans lui, l'API renvoie une erreur 503 et le formulaire propose l'e-mail.
CONTACT_WEBHOOK_URL=
